{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "VR Cube defaults",
  "bindings": {
    "/actions/cube": {
      "sources": [
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cube/in/color"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "parameters": {
            "force_input": "click"
          },
          "inputs": {
            "click": {
              "output": "/actions/cube/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cube/in/stick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cube/in/color"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "force_input": "click"
          },
          "inputs": {
            "click": {
              "output": "/actions/cube/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cube/in/stick"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/cube/in/hand",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/cube/in/hand",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "haptics": [],
      "chords": [],
      "skeleton": []
    }
  }
}