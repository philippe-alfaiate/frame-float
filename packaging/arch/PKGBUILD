# Maintainer: Philippe Alfaiate <39280579+philippe-alfaiate@users.noreply.github.com>
pkgname=frame-float-git
pkgver=r0
pkgrel=1
pkgdesc="Float a 3D model (or a cube) over SteamVR desktop mode and passthrough on the Steam Frame"
arch=('aarch64')
url="https://github.com/philippe-alfaiate/frame-float"
license=('MIT' 'BSD-3-Clause')
# libopenvr_api.so comes from SteamVR in /opt/steamvr, which Steam installs (not pacman).
depends=('glibc' 'gcc-libs' 'libglvnd')
makedepends=('git')
provides=('frame-float')
conflicts=('frame-float')
source=("frame-float::git+https://github.com/philippe-alfaiate/frame-float.git")
sha256sums=('SKIP')

pkgver() {
  cd frame-float
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd frame-float
  make frame-float-overlay
}

package() {
  cd frame-float
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for lib in openvr cgltf stb; do
    install -Dm644 "third_party/$lib/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/$lib.LICENSE"
  done
}
